# Browser-public: only set for Capacitor builds or a separately hosted Java API.
# Leave empty for the same-origin browser preview.
VITE_API_BASE_URL=
# Spring Boot: public allowed frontend origins, comma-separated.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Provider calls and accounts are intentionally disabled in v0.1.
# Do not add provider keys to any VITE_* variable.
